# Local development:
# VITE_API_BASE_URL=http://localhost:5000/api/v1
#
# Vercel production must point to the deployed backend API, not localhost.
# Example:
# VITE_API_BASE_URL=https://your-droneops-api.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Google OAuth client used by both frontend and backend.
# In Google Cloud Console, add this under Authorized JavaScript origins:
# https://droneops-five.vercel.app
VITE_GOOGLE_CLIENT_ID=
VITE_MAPBOX_TOKEN=
